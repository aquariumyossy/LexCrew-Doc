{
  "name": "guri",
  "version": "1.3.0",
  "private": true,
  "description": "LexCrew Doc。Word デスクトップ作業ウィンドウから MTPLX と SearXNG を使う法律文書アドイン",
  "license": "Elastic-2.0",
  "author": "弁護士　吉田秀平",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 28765
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "tsx src/server.ts",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "test:watch": "vitest",
    "watch": "webpack --mode development --watch",
    "tauri": "tauri",
    "dist": "tauri build",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@fluentui/react-components": "^9.55.1",
    "@fluentui/react-icons": "^2.0.264",
    "@tauri-apps/cli": "^2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/supertest": "^6.0.2",
    "@types/webpack": "^5.28.5",
    "acorn": "^8.11.3",
    "babel-loader": "^10.1.1",
    "better-sqlite3": "^13.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.36.0",
    "eslint-plugin-office-addins": "^4.0.10",
    "eslint-plugin-react": "^7.28.0",
    "express": "^4.21.2",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jszip": "^3.10.2",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "os-browserify": "^0.3.0",
    "pdfjs-dist": "^6.3.289",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "regenerator-runtime": "^0.14.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "source-map-loader": "^5.0.0",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.4.2",
    "vitest": "^3.0.8",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "overrides": {
    "adm-zip": "0.6.1"
  },
  "browserslist": [
    "last 2 versions"
  ]
}
