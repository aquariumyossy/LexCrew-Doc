{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "noImplicitReturns": true,
    "noUnusedParameters": false,
    "outDir": "dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
