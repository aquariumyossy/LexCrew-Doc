{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GURI",
  "mainBinaryName": "GURI",
  "version": "0.1.1",
  "identifier": "local.guri.app",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../tray-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GURI",
        "width": 360,
        "height": 160,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Word 向け法律文書アドインの常駐サイドカー",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "taskpane",
      "../manifest.xml": "manifest.xml"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "GURI",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
